{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hide.dev/contracts/hided-ws.schema.json",
  "title": "hided WebSocket contract",
  "description": "Handshake, server frames, close reason codes, path refusal reason codes, and client dispatch events for hided.",
  "oneOf": [
    { "$ref": "#/$defs/handshake" },
    { "$ref": "#/$defs/serverFrame" },
    { "$ref": "#/$defs/clientEvent" }
  ],
  "$defs": {
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "schema_version"],
      "properties": {
        "token": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]+$" },
        "schema_version": { "type": "integer", "const": 2 },
        "have_revision": { "type": "integer", "minimum": 0 },
        "have_terminal_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "serverFrame": {
      "description": "snapshot/delta carry the core state; error answers a malformed client event; directory_list answers a `remote_file_list` for the `local` target and path_refused answers a `remote_file_list` or `create_workspace` whose path failed the $HOME boundary (see directoryList and pathRefused).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "type": "string", "enum": ["snapshot", "delta", "error", "directory_list", "path_refused"] },
        "payload": { "type": "object" },
        "message": { "type": "string" }
      }
    },
    "clientEvent": {
      "type": "object",
      "required": ["schema_version", "kind", "payload"],
      "properties": {
        "schema_version": { "type": "integer", "const": 2 },
        "kind": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "closeReason": {
      "type": "string",
      "enum": ["invalid_token", "origin_not_allowed", "schema_mismatch", "client_limit"]
    },
    "closeCode": {
      "type": "integer",
      "enum": [4001, 4002, 4003, 4004]
    },
    "pathRefusalReason": {
      "description": "outside_home: the real path is not under $HOME (a symlink target counts). home_root: $HOME itself cannot be a workspace. not_found: nothing exists there. not_a_directory: a file. invalid_path: empty, relative, contains `..` or NUL.",
      "type": "string",
      "enum": ["outside_home", "home_root", "not_found", "not_a_directory", "invalid_path"]
    },
    "directoryList": {
      "description": "Payload of a directory_list frame: the visible subdirectories of root_path under $HOME. Files, hidden names, and symlinks that resolve outside home are absent; truncated is true past the listing cap.",
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "entries", "truncated"],
      "properties": {
        "root_path": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "pathRefused": {
      "description": "Payload of a path_refused frame: the event kind that carried the path, the path as sent, and why hided did not forward it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "reason"],
      "properties": {
        "kind": { "type": "string", "enum": ["remote_file_list", "create_workspace"] },
        "path": { "type": "string" },
        "reason": { "$ref": "#/$defs/pathRefusalReason" }
      }
    },
    "health": {
      "type": "object",
      "required": ["pid", "version", "schema_version", "clients"],
      "properties": {
        "pid": { "type": "integer" },
        "version": { "type": "string" },
        "schema_version": { "type": "integer", "const": 2 },
        "clients": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    }
  }
}
