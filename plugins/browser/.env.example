# Herdr injects its pane and socket routing when the plugin is launched.
# HERDR_ENV=1
# HERDR_PANE_ID=w1:p1
# HERDR_SOCKET_PATH=/absolute/path/to/herdr.sock
# HERDR_PLUGIN_STATE_DIR=/absolute/path/to/plugin-state
# HIDE_BROWSER_REQUEST={"profile":"work","url":"http://localhost:3000","bindingID":"qa"}
# CHROMUX_HOME=/absolute/path/to/.chromux
