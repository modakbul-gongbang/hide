{
  "id": "opencode",
  "kind": "opencode",
  "executable": "opencode",
  "model": "openai/gpt-6-luna",
  "argv": [
    "--model",
    "{model}"
  ],
  "known": [
    ".config/opencode/opencode.json",
    ".config/opencode/opencode.jsonc"
  ],
  "roots": [
    ".config/opencode",
    ".local/share/opencode"
  ],
  "login": "Use opencode auth login yourself; this tool never logs in.",
  "scenes": {
    "rest": {
      "send": "",
      "arrived": "(?:[\u203a\u276f>] .*|.*(?:Ask.*anything|What.*work on|Type.*message|Send a message).*)$",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "working": {
      "send": "Think carefully about the integer 17 and reply with exactly LIVE_READY. Do not use tools.",
      "arrived": "(?:Thinking|Working|Generating|Esc to interrupt|esc to interrupt|ctrl.c to interrupt|Running).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "shell_approval": {
      "send": "Request permission to execute exactly `touch probe-1.txt` in this folder. Do not run any other command.",
      "arrived": "(?:Allow.*(?:command|Bash|shell)|Do you want to (?:run|proceed)|Run this command|Approve.*command).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "file_approval": {
      "send": "Request permission to create probe-2.txt in this folder using the file edit tool with content probe. Do not execute any command.",
      "arrived": "(?:Allow.*(?:edit|write|file)|Apply.*(?:patch|changes)|Do you want to (?:make|apply|edit)).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "question": {
      "send": "Ask me one question using your interactive user question tool, with choices One and Two. Wait for my answer. Do not use other tools.",
      "arrived": "^\\s*(?:[\u276f\u203a>]\\s*)?(?:[1-9][.)]\\s*|\\[[ x]\\]\\s*)One\\s*$",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*",
      "controls": "^\\s*(?:Enter (?:to |: ?)(?:select|confirm).*(?:Esc|cancel)|.*[\u2191\u2193].*(?:select|navigate)|(?:Use|use) (?:arrow|\u2191).*keys)"
    },
    "plan_approval": {
      "send": "Enter plan mode and propose one step: create probe-3.txt in this folder. Ask for plan approval using your interactive approval menu. Do not implement or run any command.",
      "arrived": "(?:Implement this plan\\?|Ready to code\\?|Approve.*plan|Proceed.*plan|Execute.*plan).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "model_picker": {
      "send": "/model",
      "arrived": "(?:Select.*model|Choose.*model|Switch.*model|Model.*(?:selection|picker)|Search.*models).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "resume_picker": {
      "send": "/resume",
      "arrived": "(?:Resume.*session|Select.*session|Choose.*session|Search.*sessions|Previous sessions|Recent sessions).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "mcp_approval": {
      "send": "Use the live_probe MCP server tool ping once. Request its interactive MCP permission. Do not use a shell or any other tool.",
      "arrived": "(?:Allow.*(?:MCP|mcp|live_probe)|Approve.*(?:MCP|mcp|live_probe)|Trust.*(?:MCP|mcp|live_probe)).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    },
    "startup": {
      "send": "",
      "arrived": "(?:trust this (?:folder|directory|workspace)|Trust.*(?:folder|project|workspace)|Do you trust|security.*(?:notice|warning)|Welcome.*(?:setup|started)).*",
      "draft": "^[\u203a\u276f>] {bell}\\s*$",
      "no_match": "(?:No (?:matching |matching.*|models|sessions|results)|0 results|No matches).*",
      "unsafe": "(?:Selected model:|Resumed session:|Trust saved:|Approval accepted:).*"
    }
  },
  "model_note": "Small-model recipe default; confirm the cheapest available model for this account and use --model ID=MODEL to override. An unavailable model is unknown, never a safety pass.",
  "overlay": {
    "env": {
      "XDG_DATA_HOME": "data",
      "XDG_CACHE_HOME": "cache",
      "XDG_CONFIG_HOME": "config",
      "XDG_STATE_HOME": "state"
    },
    "copies": [
      [
        ".local/share/opencode/auth.json",
        "data/opencode/auth.json"
      ],
      [
        ".config/opencode/opencode.json",
        "config/opencode/opencode.json"
      ],
      [
        ".config/opencode/opencode.jsonc",
        "config/opencode/opencode.jsonc"
      ]
    ],
    "settings": [
      "config/opencode/opencode.json",
      "config/opencode/opencode.jsonc"
    ],
    "sessions": null,
    "provenance": "Installed opencode 1.18.30 debug paths under enforced macOS guard confirms all four XDG roots and HOME unchanged; official troubleshooting documents data/opencode/auth.json."
  },
  "mcp": {
    "format": "opencode",
    "path": "opencode.json",
    "provenance": "https://opencode.ai/docs/mcp-servers/ ; local command array and project configuration."
  }
}
