                                          "fill": "$--subtle-foreground",
                                          "fontFamily": "$--font-mono",
                                          "fontSize": "$--text-caption",
                                          "fontWeight": "400"
                                        }
                                      ],
                                      "layout": "horizontal",
                                      "gap": "$--spacing-md",
                                      "alignItems": "baseline",
                                      "width": 512,
                                      "padding": [
                                        "$--spacing-sm",
                                        0
                                      ],
                                      "stroke": "$--border",
                                      "strokeWidth": {
                                        "top": 1
                                      }
                                    }
                                  ],
                                  "layout": "vertical",
                                  "width": 512,
                                  "stroke": "$--border",
                                  "strokeWidth": {
                                    "top": 1,
                                    "bottom": 1
                                  }
                                },
                                {
                                  "type": "frame",
                                  "id": "rs-act-d",
                                  "name": "Actions",
                                  "children": [
                                    {
                                      "id": "rs-again-d",
                                      "type": "ref",
                                      "ref": "hideui:btn-m",
                                      "name": "다시 검토",
                                      "fill": "#00000000",
                                      "descendants": {
                                        "hideui:btn-ic": {
                                          "fill": "$--subtle-foreground",
                                          "icon": "refresh-cw",
                                          "enabled": true
                                        },
                                        "hideui:btn-lb": {
                                          "fill": "$--subtle-foreground",
                                          "content": "다시 검토"
                                        }
                                      }
                                    },
                                    {
                                      "id": "rs-close-d",
                                      "type": "ref",
                                      "ref": "hideui:btn-m",
                                      "name": "닫기",
                                      "fill": "$--secondary",
                                      "stroke": "$--border",
                                      "strokeWidth": "$--size-hairline",
                                      "strokeAlignment": "inner",
                                      "descendants": {
                                        "hideui:btn-ic": {
                                          "fill": "$--primary-foreground",
                                          "enabled": false
                                        },
                                        "hideui:btn-lb": {
                                          "fill": "$--subtle-foreground",
                                          "content": "닫기"
                                        }
                                      }
                                    }
                                  ],
                                  "layout": "horizontal",
                                  "gap": "$--spacing-sm",
                                  "justifyContent": "end",
                                  "width": 512
                                }
                              ],
                              "layout": "vertical",
                              "gap": "$--spacing-md",
                              "width": 560,
                              "padding": [
                                "$--spacing-md",
                                "$--spacing-lg"
                              ]
                            }
                          ],
                          "layout": "vertical",
                          "width": 560,
                          "fill": "$--popover",
                          "cornerRadius": "$--radius-lg",
                          "stroke": "$--border",
                          "strokeWidth": 1,
                          "strokeAlignment": "inner",
                          "clip": true
                        }
                      ],
                      "layout": "vertical",
                      "gap": "$--spacing-sm"
                    }
                  ],
                  "layout": "horizontal",
                  "gap": "$--spacing-xl",
                  "alignItems": "start"
                }
              ],
              "layout": "vertical",
              "gap": "$--spacing-xl"
            }
          ],
          "theme": {
            "Mode": "Dark"
          },
          "layout": "horizontal",
          "gap": "$--spacing-lg",
          "alignItems": "start",
          "padding": "$--spacing-lg",
          "fill": "$--background",
          "cornerRadius": "$--radius-md",
          "width": "fit_content"
        }
      ],
      "layout": "vertical",
      "gap": "$--spacing-xl",
      "padding": "$--spacing-xl",
      "fill": "#EDEDEE",
      "width": "fit_content",
      "x": 0,
      "y": 0
    }
  ]
}