                          "fontSize": "$--text-caption",
                          "fontWeight": "600"
                        },
                        {
                          "type": "icon",
                          "id": "mn-noticerefresh-d",
                          "name": "Glyph",
                          "enabled": true,
                          "width": 12,
                          "height": 12,
                          "icon": "refresh-cw",
                          "library": "lucide",
                          "fill": "$--muted-foreground"
                        }
                      ],
                      "layout": "horizontal",
                      "justifyContent": "space_between",
                      "alignItems": "center",
                      "width": 360
                    },
                    {
                      "type": "text",
                      "id": "mn-noticet-d",
                      "name": "Git status unavailable: ~/pr",
                      "content": "Git status unavailable: ~/projects/sasu/demo is not inside a Git repository",
                      "fill": "$--warning",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-caption",
                      "fontWeight": "400",
                      "textGrowth": "fixed-width",
                      "width": 360
                    }
                  ],
                  "width": 360,
                  "layout": "vertical",
                  "gap": "$--spacing-xxs"
                }
              ],
              "layout": "vertical",
              "gap": "$--spacing-lg"
            }
          ],
          "theme": {
            "Mode": "Dark"
          },
          "layout": "horizontal",
          "gap": "$--spacing-lg",
          "alignItems": "start",
          "padding": "$--spacing-lg",
          "fill": "$--background",
          "cornerRadius": "$--radius-md",
          "width": "fit_content"
        }
      ],
      "layout": "vertical",
      "gap": "$--spacing-xl",
      "padding": "$--spacing-xl",
      "fill": "#EDEDEE",
      "width": "fit_content",
      "x": 1400,
      "y": 1800
    }
  ]
}