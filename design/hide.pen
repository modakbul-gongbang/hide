                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "탐색기에서 키보드로 삭제할 때도 같은 확인창이 떠야 해요.",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-subhead",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t6LEt",
