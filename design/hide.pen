      "padding": "$--spacing-lg",
      "children": [
        {
          "type": "text",
          "id": "RHOcS",
          "name": "Title",
          "fill": "$--color-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Proposed / Team summary",
          "fontFamily": "$--font-ui",
