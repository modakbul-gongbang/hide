{
  "version": "2.17",
  "children": [
    {
      "type": "frame",
      "id": "band-system",
      "x": 0,
      "y": -4300,
      "name": "Band / System",
      "width": 2460,
      "layout": "vertical",
      "gap": "$--spacing-sm",
      "children": [
        {
          "type": "text",
          "id": "band-system-title",
          "name": "Title",
          "fill": "$--color-secondary",
          "content": "System",
          "fontFamily": "$--font-ui",
          "fontSize": "$--text-display",
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "band-system-holds",
          "name": "Holds",
          "fill": "$--color-muted",
          "content": "System /  token sheets and primitives generated from or tracking HideTheme",
          "fontFamily": "$--font-ui",
          "fontSize": "$--text-subhead",
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
          "id": "band-system-rule",
          "name": "Rule",
          "width": "fill_container",
          "height": 1,
          "fill": "$--color-divider"
        }
      ]
    },
    {
      "type": "frame",
      "id": "fnd-sheet",
      "name": "System / Foundations",
      "clip": true,
      "width": 1180,
      "fill": "$--color-background",
      "layout": "vertical",
      "gap": "$--spacing-xxxl",
      "padding": "$--spacing-xxl",
      "children": [
        {
          "type": "frame",
          "id": "fnd-title",
          "name": "Title block",
          "layout": "vertical",
          "gap": "$--spacing-sm",
          "width": "fill_container",
          "children": [
            {
              "type": "text",
              "id": "fnd-title-name",
              "name": "Hide",
              "fill": "$--color-primary",
              "content": "Hide",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-display",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fnd-title-sub",
              "name": "Single dark mode. Four-s",
              "fill": "$--color-secondary",
              "content": "Single dark mode. Four-step surface ladder, 1px hairlines, no drop shadows. Every value on this sheet is read from the canvas variables that gen-pen.mjs writes from HideTheme.swift, and the sheet itself is redrawn by the same run.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-subhead",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-surface",
          "name": "Surface ladder",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-surface-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-surface-title",
                  "name": "SURFACE LADDER",
                  "fill": "$--color-muted",
                  "content": "SURFACE LADDER",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-surface-ladder",
              "name": "Ladder",
              "layout": "horizontal",
              "gap": 0,
              "alignItems": "start",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-background",
                  "name": "background",
