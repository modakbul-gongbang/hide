              "children": [
                {
                  "type": "text",
                  "id": "fnd-surface-title",
                  "name": "SURFACE LADDER",
                  "fill": "$--color-muted",
                  "content": "SURFACE LADDER",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-surface-ladder",
              "name": "Ladder",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-background",
