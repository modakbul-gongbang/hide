                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-background",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": [
                    "$--radius-lg",
                    0,
                    0,
                    "$--radius-lg"
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-background-label",
                      "name": "background",
                      "fill": "$--color-primary",
                      "content": "background",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-background-value",
                      "name": "#101112",
                      "fill": "$--color-muted",
                      "content": "#101112",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
