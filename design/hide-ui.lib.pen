{
  "version": "2.18",
  "children": [
    {
      "type": "frame",
      "id": "fnd-sheet",
      "name": "System / Foundations",
      "clip": true,
      "width": 1180,
      "fill": "$--background",
      "layout": "vertical",
      "gap": "$--spacing-xxxl",
      "padding": "$--spacing-xxl",
      "children": [
        {
          "type": "frame",
          "id": "fnd-title",
          "name": "Title block",
          "layout": "vertical",
          "gap": "$--spacing-sm",
          "width": "fill_container",
          "children": [
            {
              "type": "text",
              "id": "fnd-title-name",
              "name": "Hide",
              "fill": "$--foreground",
              "content": "Hide",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-display",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fnd-title-sub",
              "name": "Medium density, light an",
              "fill": "$--subtle-foreground",
              "content": "Medium density, light and dark. Four-step surface ladder, 1px hairlines, no drop shadows. Every value on this sheet is read from the canvas variables that gen-pen.mjs writes from design/tokens.json, and the sheet itself is redrawn by the same run.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-subhead",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-palette",
          "name": "Palette",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-palette-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-palette-title",
                  "name": "PALETTE",
                  "fill": "$--muted-foreground",
                  "content": "PALETTE",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fnd-palette-note",
                  "name": "The Mode theme axis: the",
                  "fill": "$--subtle-foreground",
                  "content": "The Mode theme axis: the same variables, each with a Light value and a Dark value.",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-subhead",
                  "fontWeight": "normal",
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-palette-frames",
              "name": "Themes",
              "layout": "horizontal",
              "gap": "$--spacing-xl",
              "alignItems": "start",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-palette-light",
                  "name": "Light",
                  "layout": "vertical",
                  "gap": "$--spacing-lg",
                  "width": 540,
                  "clip": true,
                  "padding": "$--spacing-xl",
                  "fill": "$--background",
                  "cornerRadius": "$--radius-lg",
                  "theme": {
                    "Mode": "Light"
                  },
                  "children": [
                    {
                      "type": "frame",
                      "id": "fnd-palette-light-base",
                      "name": "Base",
                      "layout": "vertical",
                      "gap": "$--spacing-md",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-surface",
                          "name": "Ladder",
                          "layout": "horizontal",
                          "gap": 0,
                          "alignItems": "start",
                          "width": "fill_container",
                          "children": [
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface-background",
                              "name": "background",
                              "layout": "vertical",
                              "justifyContent": "end",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "height": 120,
                              "padding": "$--spacing-lg",
                              "fill": "$--background",
                              "stroke": "$--border",
                              "strokeWidth": "$--size-hairline",
                              "strokeAlignment": "inner",
                              "cornerRadius": [
                                "$--radius-lg",
                                0,
                                0,
                                "$--radius-lg"
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-surface-background-label",
                                  "name": "background",
                                  "fill": "$--foreground",
                                  "content": "background",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-caption",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface-sidebar",
                              "name": "sidebar",
                              "layout": "vertical",
                              "justifyContent": "end",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "height": 120,
                              "padding": "$--spacing-lg",
                              "fill": "$--sidebar",
                              "stroke": "$--border",
                              "strokeWidth": "$--size-hairline",
                              "strokeAlignment": "inner",
                              "cornerRadius": 0,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-surface-sidebar-label",
                                  "name": "sidebar",
                                  "fill": "$--foreground",
                                  "content": "sidebar",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-caption",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface-card",
                              "name": "card",
                              "layout": "vertical",
                              "justifyContent": "end",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "height": 120,
                              "padding": "$--spacing-lg",
                              "fill": "$--card",
                              "stroke": "$--border",
                              "strokeWidth": "$--size-hairline",
                              "strokeAlignment": "inner",
                              "cornerRadius": 0,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-surface-card-label",
                                  "name": "card",
                                  "fill": "$--foreground",
                                  "content": "card",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-caption",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface-popover",
                              "name": "popover",
                              "layout": "vertical",
                              "justifyContent": "end",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "height": 120,
                              "padding": "$--spacing-lg",
                              "fill": "$--popover",
                              "stroke": "$--border",
                              "strokeWidth": "$--size-hairline",
                              "strokeAlignment": "inner",
                              "cornerRadius": 0,
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-surface-popover-label",
                                  "name": "popover",
                                  "fill": "$--foreground",
                                  "content": "popover",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-caption",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-surface-secondary",
                              "name": "secondary",
                              "layout": "vertical",
                              "justifyContent": "end",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "height": 120,
                              "padding": "$--spacing-lg",
                              "fill": "$--secondary",
                              "stroke": "$--border",
                              "strokeWidth": "$--size-hairline",
                              "strokeAlignment": "inner",
                              "cornerRadius": [
                                0,
                                "$--radius-lg",
                                "$--radius-lg",
                                0
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-surface-secondary-label",
                                  "name": "secondary",
                                  "fill": "$--foreground",
                                  "content": "secondary",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-caption",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-ink",
                          "name": "Inks",
                          "layout": "horizontal",
                          "gap": "$--spacing-lg",
                          "alignItems": "start",
                          "width": "fill_container",
                          "children": [
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-ink-foreground",
                              "name": "foreground",
                              "layout": "vertical",
                              "gap": "$--spacing-xs",
                              "width": "fit_content",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-foreground-word",
                                  "name": "foreground",
                                  "fill": "$--foreground",
                                  "content": "foreground",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-title",
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-foreground-value",
                                  "name": "#18181B",
                                  "fill": "$--muted-foreground",
                                  "content": "#18181B",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-ink-subtle-foreground",
                              "name": "subtle-foreground",
                              "layout": "vertical",
                              "gap": "$--spacing-xs",
                              "width": "fit_content",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-subtle-foreground-word",
                                  "name": "subtle-foreground",
                                  "fill": "$--subtle-foreground",
                                  "content": "subtle-foreground",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-title",
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-subtle-foreground-value",
                                  "name": "#52525B",
                                  "fill": "$--muted-foreground",
                                  "content": "#52525B",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-ink-muted-foreground",
                              "name": "muted-foreground",
                              "layout": "vertical",
                              "gap": "$--spacing-xs",
                              "width": "fit_content",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-muted-foreground-word",
                                  "name": "muted-foreground",
                                  "fill": "$--muted-foreground",
                                  "content": "muted-foreground",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-title",
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-muted-foreground-value",
                                  "name": "#71717A",
                                  "fill": "$--muted-foreground",
                                  "content": "#71717A",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-ink-primary",
                              "name": "primary",
                              "layout": "vertical",
                              "gap": "$--spacing-xs",
                              "width": "fit_content",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-primary-word",
                                  "name": "primary",
                                  "fill": "$--primary",
                                  "content": "primary",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-title",
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-ink-primary-value",
                                  "name": "#84CC16",
                                  "fill": "$--muted-foreground",
                                  "content": "#84CC16",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "fnd-pal-light-accent",
                      "name": "Chips",
                      "layout": "horizontal",
                      "gap": "$--spacing-md",
                      "alignItems": "start",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-accent-accent-choice-lime",
                          "name": "lime",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-accent-accent-choice-lime-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--accent-choice-lime",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-accent-accent-choice-lime-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-lime-label",
                                  "name": "lime",
                                  "fill": "$--foreground",
                                  "content": "lime",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-body",
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-lime-value",
                                  "name": "#84CC16",
                                  "fill": "$--muted-foreground",
                                  "content": "#84CC16",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-accent-accent-choice-sky",
                          "name": "sky",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-accent-accent-choice-sky-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--accent-choice-sky",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-accent-accent-choice-sky-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-sky-label",
                                  "name": "sky",
                                  "fill": "$--foreground",
                                  "content": "sky",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-body",
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-sky-value",
                                  "name": "#38BDF8",
                                  "fill": "$--muted-foreground",
                                  "content": "#38BDF8",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-accent-accent-choice-violet",
                          "name": "violet",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-accent-accent-choice-violet-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--accent-choice-violet",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-accent-accent-choice-violet-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-violet-label",
                                  "name": "violet",
                                  "fill": "$--foreground",
                                  "content": "violet",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-body",
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-violet-value",
                                  "name": "#A78BFA",
                                  "fill": "$--muted-foreground",
                                  "content": "#A78BFA",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-accent-accent-choice-amber",
                          "name": "amber",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-accent-accent-choice-amber-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--accent-choice-amber",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-accent-accent-choice-amber-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-amber-label",
                                  "name": "amber",
                                  "fill": "$--foreground",
                                  "content": "amber",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-body",
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-accent-accent-choice-amber-value",
                                  "name": "#FB923C",
                                  "fill": "$--muted-foreground",
                                  "content": "#FB923C",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "fnd-pal-light-semantic",
                      "name": "Chips",
                      "layout": "horizontal",
                      "gap": "$--spacing-md",
                      "alignItems": "start",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-semantic-agent-working",
                          "name": "agent working",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-semantic-agent-working-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--agent-working",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-semantic-agent-working-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-semantic-agent-working-label",
                                  "name": "agent working",
                                  "fill": "$--foreground",
                                  "content": "agent working",
                                  "fontFamily": "$--font-ui",
                                  "fontSize": "$--text-body",
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-semantic-agent-working-value",
                                  "name": "#2563EB",
                                  "fill": "$--muted-foreground",
                                  "content": "#2563EB",
                                  "fontFamily": "$--font-mono",
                                  "fontSize": "$--text-micro",
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "fnd-pal-light-semantic-success",
                          "name": "success",
                          "layout": "vertical",
                          "gap": "$--spacing-md",
                          "width": "fill_container",
                          "padding": "$--spacing-lg",
                          "fill": "$--card",
                          "stroke": "$--border",
                          "strokeWidth": "$--size-hairline",
                          "strokeAlignment": "inner",
                          "cornerRadius": "$--radius-lg",
                          "children": [
                            {
                              "type": "rectangle",
                              "id": "fnd-pal-light-semantic-success-dot",
                              "name": "Colour",
                              "width": 24,
                              "height": 24,
                              "fill": "$--success",
                              "cornerRadius": "$--radius-sm"
                            },
                            {
                              "type": "frame",
                              "id": "fnd-pal-light-semantic-success-text",
                              "name": "Text",
                              "layout": "vertical",
                              "gap": "$--spacing-xxs",
                              "width": "fill_container",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fnd-pal-light-semantic-success-label",
                                  "name": "success",
                                  "fill": "$--foreground",
