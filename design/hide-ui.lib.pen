    {
      "type": "frame",
      "id": "session-row-sheet",
      "x": 4440,
      "y": 7264,
      "name": "Component / Session row",
      "width": 400,
      "fill": "$--card",
      "cornerRadius": "$--radius-md",
      "layout": "vertical",
      "gap": "$--spacing-lg",
      "padding": "$--spacing-md",
      "children": [
        {
          "type": "frame",
          "id": "session-row-sheet-title",
          "name": "Title block",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$--spacing-xxs",
          "children": [
            {
              "type": "text",
              "id": "session-row-sheet-title-name",
              "name": "Title",
              "fill": "$--foreground",
              "content": "Session row (web Project Sessions)",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-title",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "session-row-sheet-title-spec",
              "name": "Spec",
              "fill": "$--subtle-foreground",
              "content": "One row per session in a Project's Sessions list, newest first: the provider mark and name, the time, the first request or title (two lines at most, full text in the tooltip), and the checkout it ran in. Nothing is invented: a session with no request or title reads Untitled session, muted, and a time the session never carried is left out. The open session's row sits on --color-elevated and is aria-current. An unreadable session dims only its own row, marks it ! unavailable and keeps its reason, Retry and Copy source location under it. The row reads aloud as provider, first request, checkout, time and availability. The list place states are single marks: loading, none yet, no match with Clear filters, a failed read with Retry, and a device reason.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-caption",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
