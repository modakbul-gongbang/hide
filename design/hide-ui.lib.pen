              "fontFamily": "$--font-ui",
              "fontSize": "$--text-title",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "pane-child-row-sheet-title-spec",
              "name": "Spec",
              "fill": "$--subtle-foreground",
              "content": "Every direct child on one 24pt row under the pane header (--size-pane-child-row); each chip is a status mark, the provider mark and a title capped at --size-pane-child-chip-max. The row clips and scrolls sideways instead of growing, and a pane with no children has no row. A chip opens the existing child at once; while that move is in flight it shows … and ignores repeats; a failure puts the core reason under the header with Retry (when retryable) and Dismiss. Supersedes first child + N for the web shell; the native pane header keeps its own master until the native shell changes.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-caption",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
