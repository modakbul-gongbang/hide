{
  "version": "2.18",
  "children": [
    {
      "type": "frame",
      "id": "fnd-sheet",
      "name": "System / Foundations",
      "clip": true,
      "width": 1180,
      "fill": "$--color-background",
      "layout": "vertical",
      "gap": "$--spacing-xxxl",
      "padding": "$--spacing-xxl",
      "children": [
        {
          "type": "frame",
          "id": "fnd-title",
          "name": "Title block",
          "layout": "vertical",
          "gap": "$--spacing-sm",
          "width": "fill_container",
          "children": [
            {
              "type": "text",
              "id": "fnd-title-name",
              "name": "Hide",
              "fill": "$--color-primary",
              "content": "Hide",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-display",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fnd-title-sub",
              "name": "Single dark mode. Four-s",
              "fill": "$--color-secondary",
              "content": "Single dark mode. Four-step surface ladder, 1px hairlines, no drop shadows. Every value on this sheet is read from the canvas variables that gen-pen.mjs writes from HideTheme.swift, and the sheet itself is redrawn by the same run.",
              "fontFamily": "$--font-ui",
              "fontSize": "$--text-subhead",
              "fontWeight": "normal",
              "textGrowth": "fixed-width",
              "width": "fill_container"
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-surface",
          "name": "Surface ladder",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-surface-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-surface-title",
                  "name": "SURFACE LADDER",
                  "fill": "$--color-muted",
                  "content": "SURFACE LADDER",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-surface-ladder",
              "name": "Ladder",
              "layout": "horizontal",
              "gap": 0,
              "alignItems": "start",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-background",
                  "name": "background",
                  "layout": "vertical",
                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-background",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": [
                    "$--radius-lg",
                    0,
                    0,
                    "$--radius-lg"
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-background-label",
                      "name": "background",
                      "fill": "$--color-primary",
                      "content": "background",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-background-value",
                      "name": "#101112",
                      "fill": "$--color-muted",
                      "content": "#101112",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-sidebar",
                  "name": "sidebar",
                  "layout": "vertical",
                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-sidebar",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": 0,
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-sidebar-label",
                      "name": "sidebar",
                      "fill": "$--color-primary",
                      "content": "sidebar",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-sidebar-value",
                      "name": "#171819",
                      "fill": "$--color-muted",
                      "content": "#171819",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-panel",
                  "name": "panel",
                  "layout": "vertical",
                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-panel",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": 0,
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-panel-label",
                      "name": "panel",
                      "fill": "$--color-primary",
                      "content": "panel",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-panel-value",
                      "name": "#1D1F21",
                      "fill": "$--color-muted",
                      "content": "#1D1F21",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-elevated",
                  "name": "elevated",
                  "layout": "vertical",
                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-elevated",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": 0,
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-elevated-label",
                      "name": "elevated",
                      "fill": "$--color-primary",
                      "content": "elevated",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-elevated-value",
                      "name": "#27292C",
                      "fill": "$--color-muted",
                      "content": "#27292C",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-surface-ladder-color-balloon",
                  "name": "balloon",
                  "layout": "vertical",
                  "justifyContent": "end",
                  "gap": "$--spacing-xxs",
                  "width": "fill_container",
                  "height": 140,
                  "padding": "$--spacing-lg",
                  "fill": "$--color-balloon",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": [
                    0,
                    "$--radius-lg",
                    "$--radius-lg",
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-balloon-label",
                      "name": "balloon",
                      "fill": "$--color-primary",
                      "content": "balloon",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-body",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fnd-surface-ladder-color-balloon-value",
                      "name": "#34373B",
                      "fill": "$--color-muted",
                      "content": "#34373B",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-ink",
          "name": "Text",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-ink-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-ink-title",
                  "name": "TEXT",
                  "fill": "$--color-muted",
                  "content": "TEXT",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-ink-set",
              "name": "Inks",
              "layout": "horizontal",
              "gap": "$--spacing-xxxl",
              "alignItems": "start",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-ink-set-color-primary",
                  "name": "primary",
                  "layout": "vertical",
                  "gap": "$--spacing-xs",
                  "width": "fit_content",
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-primary-word",
                      "name": "primary",
                      "fill": "$--color-primary",
                      "content": "primary",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-display",
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-primary-value",
                      "name": "#F4F4F6",
                      "fill": "$--color-muted",
                      "content": "#F4F4F6",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-ink-set-color-secondary",
                  "name": "secondary",
                  "layout": "vertical",
                  "gap": "$--spacing-xs",
                  "width": "fit_content",
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-secondary-word",
                      "name": "secondary",
                      "fill": "$--color-secondary",
                      "content": "secondary",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-display",
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-secondary-value",
                      "name": "#A4A5A8",
                      "fill": "$--color-muted",
                      "content": "#A4A5A8",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-ink-set-color-muted",
                  "name": "muted",
                  "layout": "vertical",
                  "gap": "$--spacing-xs",
                  "width": "fit_content",
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-muted-word",
                      "name": "muted",
                      "fill": "$--color-muted",
                      "content": "muted",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-display",
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-muted-value",
                      "name": "#92959A",
                      "fill": "$--color-muted",
                      "content": "#92959A",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-ink-set-color-accent",
                  "name": "accent",
                  "layout": "vertical",
                  "gap": "$--spacing-xs",
                  "width": "fit_content",
                  "children": [
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-accent-word",
                      "name": "accent",
                      "fill": "$--color-accent",
                      "content": "accent",
                      "fontFamily": "$--font-ui",
                      "fontSize": "$--text-display",
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "fnd-ink-set-color-accent-value",
                      "name": "#D3D3D4",
                      "fill": "$--color-muted",
                      "content": "#D3D3D4",
                      "fontFamily": "$--font-mono",
                      "fontSize": "$--text-micro",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-semantic",
          "name": "Semantic",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-semantic-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-semantic-title",
                  "name": "SEMANTIC",
                  "fill": "$--color-muted",
                  "content": "SEMANTIC",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fnd-semantic-note",
                  "name": "The only saturated colou",
                  "fill": "$--color-secondary",
                  "content": "The only saturated colour in the chrome. Everything else stays on the neutral ladder.",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-subhead",
                  "fontWeight": "normal",
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-semantic-set",
              "name": "Chips",
              "layout": "horizontal",
              "gap": "$--spacing-md",
              "alignItems": "start",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-semantic-set-color-agent-working",
                  "name": "agent working",
                  "layout": "vertical",
                  "gap": "$--spacing-md",
                  "width": "fill_container",
                  "padding": "$--spacing-lg",
                  "fill": "$--color-panel",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": "$--radius-lg",
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "fnd-semantic-set-color-agent-working-dot",
                      "name": "Colour",
                      "width": 24,
                      "height": 24,
                      "fill": "$--color-agent-working",
                      "cornerRadius": "$--radius-sm"
                    },
                    {
                      "type": "frame",
                      "id": "fnd-semantic-set-color-agent-working-text",
                      "name": "Text",
                      "layout": "vertical",
                      "gap": "$--spacing-xxs",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-agent-working-label",
                          "name": "agent working",
                          "fill": "$--color-primary",
                          "content": "agent working",
                          "fontFamily": "$--font-ui",
                          "fontSize": "$--text-body",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-agent-working-value",
                          "name": "#61A6FF",
                          "fill": "$--color-muted",
                          "content": "#61A6FF",
                          "fontFamily": "$--font-mono",
                          "fontSize": "$--text-micro",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-semantic-set-color-success",
                  "name": "success",
                  "layout": "vertical",
                  "gap": "$--spacing-md",
                  "width": "fill_container",
                  "padding": "$--spacing-lg",
                  "fill": "$--color-panel",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": "$--radius-lg",
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "fnd-semantic-set-color-success-dot",
                      "name": "Colour",
                      "width": 24,
                      "height": 24,
                      "fill": "$--color-success",
                      "cornerRadius": "$--radius-sm"
                    },
                    {
                      "type": "frame",
                      "id": "fnd-semantic-set-color-success-text",
                      "name": "Text",
                      "layout": "vertical",
                      "gap": "$--spacing-xxs",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-success-label",
                          "name": "success",
                          "fill": "$--color-primary",
                          "content": "success",
                          "fontFamily": "$--font-ui",
                          "fontSize": "$--text-body",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-success-value",
                          "name": "#5EE69E",
                          "fill": "$--color-muted",
                          "content": "#5EE69E",
                          "fontFamily": "$--font-mono",
                          "fontSize": "$--text-micro",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-semantic-set-color-warning",
                  "name": "warning",
                  "layout": "vertical",
                  "gap": "$--spacing-md",
                  "width": "fill_container",
                  "padding": "$--spacing-lg",
                  "fill": "$--color-panel",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": "$--radius-lg",
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "fnd-semantic-set-color-warning-dot",
                      "name": "Colour",
                      "width": 24,
                      "height": 24,
                      "fill": "$--color-warning",
                      "cornerRadius": "$--radius-sm"
                    },
                    {
                      "type": "frame",
                      "id": "fnd-semantic-set-color-warning-text",
                      "name": "Text",
                      "layout": "vertical",
                      "gap": "$--spacing-xxs",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-warning-label",
                          "name": "warning",
                          "fill": "$--color-primary",
                          "content": "warning",
                          "fontFamily": "$--font-ui",
                          "fontSize": "$--text-body",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-warning-value",
                          "name": "#FFB847",
                          "fill": "$--color-muted",
                          "content": "#FFB847",
                          "fontFamily": "$--font-mono",
                          "fontSize": "$--text-micro",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fnd-semantic-set-color-danger",
                  "name": "danger",
                  "layout": "vertical",
                  "gap": "$--spacing-md",
                  "width": "fill_container",
                  "padding": "$--spacing-lg",
                  "fill": "$--color-panel",
                  "stroke": "$--color-divider",
                  "strokeWidth": "$--size-hairline",
                  "strokeAlignment": "inner",
                  "cornerRadius": "$--radius-lg",
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "fnd-semantic-set-color-danger-dot",
                      "name": "Colour",
                      "width": 24,
                      "height": 24,
                      "fill": "$--color-danger",
                      "cornerRadius": "$--radius-sm"
                    },
                    {
                      "type": "frame",
                      "id": "fnd-semantic-set-color-danger-text",
                      "name": "Text",
                      "layout": "vertical",
                      "gap": "$--spacing-xxs",
                      "width": "fill_container",
                      "children": [
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-danger-label",
                          "name": "danger",
                          "fill": "$--color-primary",
                          "content": "danger",
                          "fontFamily": "$--font-ui",
                          "fontSize": "$--text-body",
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "fnd-semantic-set-color-danger-value",
                          "name": "#FF595C",
                          "fill": "$--color-muted",
                          "content": "#FF595C",
                          "fontFamily": "$--font-mono",
                          "fontSize": "$--text-micro",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "fnd-pr",
          "name": "Pull request and diff",
          "layout": "vertical",
          "gap": "$--spacing-lg",
          "width": "fill_container",
          "children": [
            {
              "type": "frame",
              "id": "fnd-pr-head",
              "name": "Heading",
              "layout": "vertical",
              "gap": "$--spacing-xs",
              "width": "fill_container",
              "children": [
                {
                  "type": "text",
                  "id": "fnd-pr-title",
                  "name": "PULL REQUEST AND DIFF",
                  "fill": "$--color-muted",
                  "content": "PULL REQUEST AND DIFF",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-caption",
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fnd-pr-note",
                  "name": "Status colours a row sho",
                  "fill": "$--color-secondary",
                  "content": "Status colours a row shows for a pull request, and the tints a diff draws.",
                  "fontFamily": "$--font-ui",
                  "fontSize": "$--text-subhead",
                  "fontWeight": "normal",
                  "textGrowth": "fixed-width",
                  "width": "fill_container"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fnd-pr-body",
              "name": "Rows",
              "layout": "vertical",
              "gap": "$--spacing-md",
              "width": "fill_container",
              "children": [
                {
                  "type": "frame",
                  "id": "fnd-pr-set",
                  "name": "Chips",
                  "layout": "horizontal",
                  "gap": "$--spacing-md",
                  "alignItems": "start",
                  "width": "fill_container",
                  "children": [
                    {
                      "type": "frame",
                      "id": "fnd-pr-set-color-pr-open",
                      "name": "open",
                      "layout": "vertical",
                      "gap": "$--spacing-md",
                      "width": "fill_container",
                      "padding": "$--spacing-lg",
                      "fill": "$--color-panel",
                      "stroke": "$--color-divider",
                      "strokeWidth": "$--size-hairline",
                      "strokeAlignment": "inner",
                      "cornerRadius": "$--radius-lg",
                      "children": [
                        {
                          "type": "rectangle",
                          "id": "fnd-pr-set-color-pr-open-dot",
                          "name": "Colour",
                          "width": 24,
                          "height": 24,
                          "fill": "$--color-pr-open",
                          "cornerRadius": "$--radius-sm"
                        },
                        {
                          "type": "frame",
