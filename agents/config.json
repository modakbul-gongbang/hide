{
  "delivery": {
    "mode": "pr",
    "baseBranch": "main",
    "branchPrefix": "gen-prd",
    "ci": {
      "watch": true,
      "maxFixAttempts": 2,
      "timeoutSeconds": 240
    },
    "assetsRepo": "yansfil/pr-assets"
  },
  "worktree": {
    "enabled": true,
    "link": [],
    "copy": [],
    "setup": []
  },
  "principles": [
    "~/projects/oh-my-principle"
  ],
  "judge": {
    "retryBudget": 15,
    "readMaxRounds": 60
  },
  "verify": {
    "commands": {
      "test": "bash scripts/verify-cargo.sh test",
      "lint": "bash scripts/verify-cargo.sh lint",
      "build": "bash scripts/verify-swift.sh test"
    }
  }
}
