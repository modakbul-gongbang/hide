+                "message": format!("pane {pane_id} is not a terminal surface")
+            }
+        });
+        eprintln!("{error}");
+        return Ok(1);
+    };
+    crate::client::run_terminal_attach(attach.terminal_id.clone(), takeover)?;
+    Ok(0)
+}
