#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from t16_retirement.inventory import InventoryError, inventory, write_json


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="t16-retirement", description="Read-only supersession and retirement evidence")
    parser.add_argument("--project-root", required=True, type=Path)
    parser.add_argument("--pet-root", required=True, type=Path)
    parser.add_argument("--output", type=Path)
    arguments = parser.parse_args(argv)
    try:
        result = inventory(arguments.project_root, arguments.pet_root)
        if arguments.output:
            write_json(arguments.output, result)
            result["output"] = str(arguments.output)
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0
    except InventoryError as error:
        print(json.dumps({"schema": "herdr.ide.t16-retirement-failure.v1", "status": "FAIL", "error": str(error)}, ensure_ascii=False), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
