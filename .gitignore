target
target/
spikes/*/target
*.app/

# stray CLI artifact
--output
__pycache__/
*.pyc
.env
# SwiftPM build output
.build/
.build-boundary/
macos/build/
# Stray SwiftPM compile output; these carry absolute paths
*.d
*.o
*.swiftdeps
# The compiler writes a `~` backup beside each of the above; ignoring only the
# plain name let four of them reach `git status` as untracked candidates.
*~
*.swiftmodule
*.swiftsourceinfo
*.swiftdoc
*.dia
